# Copy this file to .env and fill in your values
# cp .env.example .env
#
# NOTE: .env is in .gitignore and will never be committed.
# La API key la configura SOLO el administrador de la app (del lado del
# servidor). Los visitantes nunca ingresan ninguna clave.
#   - Local:            pon tu clave aquí (archivo .env)
#   - Streamlit Cloud:  Settings → Secrets →  OPENAI_API_KEY = "sk-..."

# OpenAI API Key (required) — get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here...

# Optional: override default model names
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o

# Optional: ChromaDB persistence path (defaults to ./chroma_db)
CHROMA_PERSIST_DIR=./chroma_db
